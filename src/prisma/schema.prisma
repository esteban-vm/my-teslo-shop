generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL

  @@map("sizes")
}

enum Gender {
  men    @map("Men")
  women  @map("Women")
  kids   @map("Kids")
  unisex @map("Unisex")

  @@map("genders")
}

enum Role {
  user
  admin

  @@map("user_roles")
}

enum CategoryName {
  Shirts  @map("T-Shirts")
  Pants
  Hoodies
  Hats

  @@map("category_names")
}

// MODELS
model Category {
  id       String       @id @default(cuid())
  name     CategoryName @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String
  stock       Int
  price       Float       @default(0)
  sizes       Size[]      @default([])
  gender      Gender
  slug        String      @unique
  tags        String[]    @default([])
  categoryId  String      @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id])
  images      Picture[]
  orderItems  OrderItem[]

  @@index([gender])
  @@map("products")
}

model Picture {
  id        Int     @id @default(autoincrement())
  url       String? @default("imgs/placeholder.jpg")
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("pictures")
}

model Country {
  id                String            @id
  name              String
  billingAddresses  BillingAddress[]
  shippingAddresses ShippingAddress[]

  @@map("countries")
}

model BillingAddress {
  id         String  @id @default(cuid())
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  address    String
  address2   String?
  postalCode String  @map("postal_code")
  phone      String
  city       String
  country    Country @relation(fields: [countryId], references: [id])
  countryId  String  @map("country_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique @map("user_id")

  @@map("billing_addresses")
}

// ORDER
model Order {
  id              String           @id @default(cuid())
  total           Float
  subtotal        Float
  tax             Float
  totalItems      Int              @map("total_items")
  isPaid          Boolean?         @default(false) @map("is_paid")
  paidAt          DateTime?        @map("paid_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String           @map("user_id")
  transactionId   String?          @map("transaction_id")
  items           OrderItem[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  shippingAddress ShippingAddress?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  size      Size
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String  @map("order_id")
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  @@map("order_items")
}

model ShippingAddress {
  id         String  @id @default(cuid())
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  address    String
  address2   String?
  postalCode String  @map("postal_code")
  phone      String
  city       String
  country    Country @relation(fields: [countryId], references: [id])
  countryId  String  @map("country_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String  @unique @map("order_id")

  @@map("shipping_addresses")
}

// BETTER AUTH
model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  emailVerified Boolean         @map("email_verified")
  image         String?
  role          Role?           @default(user)
  address       BillingAddress?
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}

model Account {
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("verifications")
}
